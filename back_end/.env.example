PORT=8000

# --- Phân quyền Giáo Viên ---
# Đổi mật khẩu tại đây trước khi dùng thực tế
ADMIN_PASSWORD=vstep_admin_2025
TEACHER_PASSWORD=vstep_teacher_2025
TEMPERATURE=0.3
WHISPER_MODEL=large-v3

# --- Cấu hình LM Studio (Chạy AI cục bộ Offline) ---
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
QWEN_MODEL=qwen2.5-14b-instruct-1m
LM_STUDIO_TIMEOUT=600

# --- Cấu hình Google Gemini (Chạy AI qua Cloud) ---
# Bỏ dấu # và dán API Key của bạn vào nếu muốn dùng Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# --- Tự động chấm mô phỏng khi cả 2 AI đều offline (tránh sập app khi test) ---
ALLOW_OFFLINE_MOCK=True
